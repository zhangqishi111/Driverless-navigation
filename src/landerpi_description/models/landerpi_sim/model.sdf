<?xml version="1.0"?>
<sdf version="1.8">
  <model name="landerpi_sim">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>

    <link name="base_link">
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0221</ixx>
          <iyy>0.0281</iyy>
          <izz>0.0424</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.32 0.28 0.10</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.32 0.28 0.10</size></box></geometry>
        <material>
          <ambient>0.10 0.35 0.80 1</ambient>
          <diffuse>0.10 0.35 0.80 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel_link">
      <pose relative_to="base_link">0 0.14 -0.04 1.5708 0 0</pose>
      <inertial>
        <mass>0.20</mass>
        <inertia><ixx>0.00025</ixx><iyy>0.00025</iyy><izz>0.00010</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <link name="right_wheel_link">
      <pose relative_to="base_link">0 -0.14 -0.04 1.5708 0 0</pose>
      <inertial>
        <mass>0.20</mass>
        <inertia><ixx>0.00025</ixx><iyy>0.00025</iyy><izz>0.00010</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_caster_link">
      <pose relative_to="base_link">-0.12 0 -0.075 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
    </link>

    <link name="laser_link">
      <pose relative_to="base_link">0 0 0.16 0 0 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.035</radius><length>0.035</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.035</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <topic>/sim/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel_link</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel_link</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="rear_caster_joint" type="ball">
      <parent>base_link</parent><child>rear_caster_link</child>
    </joint>
    <joint name="laser_joint" type="fixed">
      <parent>base_link</parent><child>laser_link</child>
    </joint>

    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.28</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/sim/odom</odom_topic>
      <tf_topic>/sim/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
    </plugin>
  </model>
</sdf>
