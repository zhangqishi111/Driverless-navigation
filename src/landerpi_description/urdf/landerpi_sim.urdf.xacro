<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="landerpi_sim">
  <material name="landerpi_blue">
    <color rgba="0.10 0.35 0.80 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.32 0.28 0.10"/>
      </geometry>
      <material name="landerpi_blue"/>
    </visual>
  </link>

  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.035"/>
      </geometry>
      <material name="landerpi_blue"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
  </joint>
</robot>
