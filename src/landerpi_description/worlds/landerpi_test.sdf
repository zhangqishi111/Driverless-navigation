<?xml version="1.0"?>
<sdf version="1.8">
  <world name="landerpi_test">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></visual>
      </link>
    </model>

    <include>
      <uri>model://landerpi_sim</uri>
      <pose>0 0 0.10 0 0 0</pose>
    </include>

    <model name="north_wall"><static>true</static><pose>0 2 0.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4.2 0.10 0.50</size></box></geometry></collision><visual name="visual"><geometry><box><size>4.2 0.10 0.50</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -2 0.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4.2 0.10 0.50</size></box></geometry></collision><visual name="visual"><geometry><box><size>4.2 0.10 0.50</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>2 0 0.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.10 4.2 0.50</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.10 4.2 0.50</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-2 0 0.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.10 4.2 0.50</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.10 4.2 0.50</size></box></geometry></visual></link></model>
    <model name="center_obstacle"><static>true</static><pose>0.8 0.6 0.30 0 0 0.3</pose><link name="link"><collision name="collision"><geometry><box><size>0.6 0.4 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 0.4 0.6</size></box></geometry><material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.8 0.2 0.1 1</diffuse></material></visual></link></model>
  </world>
</sdf>

