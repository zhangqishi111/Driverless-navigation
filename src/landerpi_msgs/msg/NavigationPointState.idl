#include "geometry_msgs/msg/Pose.idl"

module landerpi_msgs {
  module msg {
    module NavigationPointState_Constants {
      const uint8 PENDING = 0;
      const uint8 PLANNING = 1;
      const uint8 NAVIGATING = 2;
      const uint8 WAITING_FOR_STOP = 3;
      const uint8 SUCCEEDED = 4;
      const uint8 FAILED = 5;
      const uint8 CANCELLED = 6;
      const uint8 NOT_EXECUTED = 7;
    };

    struct NavigationPointState {
      uint8 index;
      geometry_msgs::msg::Pose target;
      uint8 state;
      boolean has_arrival_error;
      float arrival_error_m;
      float elapsed_time_s;
      uint8 retry_count;
      string detail;
    };
  };
};
