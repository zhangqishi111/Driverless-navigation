<?xml version="1.0"?>
<package format="3">
  <name>landerpi_sandbox_display</name>
  <version>0.1.0</version>
  <description>Sandbox map and robot-state display.</description>
  <maintainer email="team@example.com">LanderPi Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>landerpi_msgs</exec_depend>
